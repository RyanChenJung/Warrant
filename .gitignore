.DS_Store
.remember/
docs/thesis/

# Databases live in the data directory outside the repo ($WARRANT_DATA_DIR) and are never
# committed; only tiny test fixtures are, and those as SQL that the tests build databases from.
*.sqlite
*.sqlite3
*.db
*.duckdb
!tests/fixtures/**
tests/fixtures/**/*.sqlite
tests/fixtures/**/*.sqlite3
tests/fixtures/**/*.db
tests/fixtures/**/*.duckdb

# Secrets (model access stays in a local AWS profile or environment variables)
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
# uv.lock IS committed: it pins the dependency set for reproducibility.

# Local agent worktrees
.claude/worktrees/

# Thesis figures stay local, like docs/thesis/
docs/figures/
